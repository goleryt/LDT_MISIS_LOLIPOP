# Reference only: enter real values in the platform's secret/variable store.
ENVIRONMENT=production
POSTGRES_HOST=REPLACE_WITH_PRIVATE_POSTGRES_HOST
POSTGRES_PORT=5432
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_IN_SECRET_STORE
POSTGRES_SSLMODE=prefer
AUTH_PROVIDER=local
SECURE_COOKIES=true
ALLOW_MOCK_INGESTION=false
ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_DOMAIN,localhost,127.0.0.1,healthcheck.railway.app
CORS_ORIGINS=https://REPLACE_WITH_PUBLIC_DOMAIN
SOURCE_TIMEZONE=Europe/Moscow
WEB_CONCURRENCY=2
PORT=8080
# APP_COMMIT=unknown  # Prefer build ARG with a clean commit; Railway's runtime SHA is also recognised.
# BACKUP_STATUS_DIR=/backup-status  # Only if a readable backup metadata mount exists.
# Keep these identical across all instances; increase only after isolated capacity tests.
IMPORT_MAX_CONCURRENT=2
IMPORT_RETRY_AFTER_SECONDS=3
IMPORT_TIMEOUT_SECONDS=240
MAX_XLSX_UNCOMPRESSED_BYTES=67108864
