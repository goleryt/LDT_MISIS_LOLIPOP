ENVIRONMENT=development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ldt_misis
POSTGRES_USER=ldt_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_SSLMODE=prefer
AUTH_PROVIDER=local
SECURE_COOKIES=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
MAX_UPLOAD_BYTES=52428800
SOURCE_TIMEZONE=Europe/Moscow
ALLOW_MOCK_INGESTION=false
# Production: ENVIRONMENT=production, SECURE_COOKIES=true, explicit host and HTTPS origin.
# LDAP_HOST=directory.customer.example
# LDAP_BASE_DN=DC=customer,DC=example
# LDAP_BIND_DN=CN=ReadOnlyService,OU=Services,DC=customer,DC=example
# LDAP_BIND_PASSWORD=
# LDAP_CA_FILE=/run/certs/corporate-ca.pem
# LDAP_ROLE_GROUPS={"CN=Dispatchers,OU=Groups,DC=customer,DC=example":"dispatcher"}
# ML (пакет LCT_ML_backend_v1): суточный расчёт scripts.run_ml_daily, API его не запускает.
# ML_BUNDLES_DIR=            # по умолчанию models/bundles в корне репозитория
# ML_EXPORT_DAYS=430         # окно журнала для расчёта: не меньше 401 суток (требование газового bundle)
# ML_TOP_K_PER_DAY=25
# ML_COOLDOWN_DAYS=3
# Independent synthetic scenario modules; opt-in only after isolated acceptance.
SCENARIO_ENABLED=false
SCENARIO_SENSOR_ENABLED=true
SCENARIO_FIRE_ENABLED=true
SCENARIO_ALLOW_PRODUCTION=false
# Python 3.12 worker image only; never run this runtime inside the web API.
# SCENARIO_COMPUTE_SCRIPT=/opt/combined/compute.py
# SCENARIO_READY_DIR=/scenario-ready
# SCENARIO_TIMEOUT_SECONDS=180
# SCENARIO_MAX_ROWS=200000
